{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "practice-firebase-72df1",
          "appId": "1:564223619997:android:170b65e4929f759d233574",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "practice-firebase-72df1",
          "configurations": {
            "android": "1:564223619997:android:170b65e4929f759d233574",
            "ios": "1:564223619997:ios:b9d69e6cf6fe5d87233574",
            "web": "1:564223619997:web:382c753c3b586f52233574"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "target": "web",
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/@(index.html|flutter_service_worker.js|flutter_bootstrap.js|version.json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "codebase": "tashil-mobile-notifications",
      "source": "functions",
      "runtime": "nodejs22"
    }
  ],
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    }
  }
}
