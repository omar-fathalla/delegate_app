function requestStaffUpdateOk(requestId) {
let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
let r = u.get('role', '');
return !signedIn() ? false
: r in superAdminRoleList()
? true
: r in techRoleList()
? techRequestReviewOk(requestId)
