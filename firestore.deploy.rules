match /leave_requests/{requestId} {
function leaveBackdateDays(d) {
return d.get('isHourly', false) == true ? 31
: (d.get('type', '') in ['sick', 'emergency', 'absence'] ? 8 : 1);
}
function leaveOwnerCreateOk() {
let d = request.resource.data;
return d.get('status', '') == 'pending'
