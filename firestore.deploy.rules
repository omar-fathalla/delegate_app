function subscriptionPaymentUntouched() {
let incoming = request.resource.data;
let before = resource == null ? {} : resource.data;
let wasPaid = before.get('paymentStatus', '') == 'paid';
return (incoming.get('paymentStatus', '') != 'paid' || wasPaid)
&& incoming.get('paymob', null) == before.get('paymob', null)
&& incoming.get('applyState', '') == before.get('applyState', '')
&& incoming.get('paymentError', null) == before.get('paymentError', null)
&& incoming.get('needsReview', false) == before.get('needsReview', false)
&& incoming.get('quotedAt', null) == before.get('quotedAt', null)
&& (!wasPaid || !incoming.diff(before).affectedKeys().hasAny([
'paymentStatus', 'paymob', 'paidAt', 'amountPaid', 'amountDue',
'coveredDelegateUids', 'items', 'periodCode', 'requestType', 'applyState',
'paymentError', 'needsReview', 'paymentMethod', 'status', 'quotedAt'
]))
&& waivedWriteOk()
&& newDelegateApprovalPaymentOk();
}
function subscriptionPaymentCreateOk() {
let d = request.resource.data;
return d.get('paymentStatus', '') != 'paid'
&& d.get('paymob', null) == null
&& d.get('applyState', '') == ''
&& d.get('paymentError', null) == null
&& d.get('needsReview', false) == false
&& d.get('quotedAt', null) == null
&& waivedWriteOk()
&& d.get('amountPaid', 0) == 0
&& (!d.keys().hasAll(['coveredDelegateUids'])
|| (d.coveredDelegateUids is list
&& d.coveredDelegateUids.size() >= 1
&& d.coveredDelegateUids.size() <= 100));
}
function freePromotionEnded() {
return request.time >= (timestamp.date(2026, 12, 31) + duration.value(22, 'h'));
}
function waivedWriteOk() {
let incoming = request.resource.data.get('paymentStatus', '');
let before = resource == null ? '' : resource.data.get('paymentStatus', '');
return incoming != 'waived' || before == 'waived' || !freePromotionEnded();
}
function newDelegateApprovalPaymentOk() {
let incoming = request.resource.data;
let before = resource == null ? {} : resource.data;
let ty = incoming.get('requestType', before.get('requestType', ''));
let st = incoming.get('status', '');
let method = incoming.get('paymentMethod', before.get('paymentMethod', ''));
let pay = incoming.get('paymentStatus', before.get('paymentStatus', ''));
return st != 'approved'
|| (ty != 'new_delegate' && ty != 'renewal')
|| method != 'paymob'
|| pay == 'paid'
|| pay == 'waived'
|| pay == 'not_required';
}
function isBaseChainOrg(org) {
let cfg = /databases/$(database)/documents/config/subscriptions;
return exists(cfg) && org in get(cfg).data.get('freeChainOrgUids', []);
}
function delegateRequestReadOk() {
let d = resource.data;
let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
let r = u.get('role', '');
let org = u.get('organizationUID', '');
let co = u.get('companyUID', '');
let docOrg = d.get('organizationUID', d.get('organizationId', ''));
let docCo = d.get('companyUID', d.get('companyId', ''));
return r in staffRoleListGlobal()
|| (r in orgAdminCoreRoles()
&& org != '' && docOrg == org && !isBaseChainOrg(org))
|| (r in companyAdminHrRoles()
&& co != '' && docCo == co)
|| d.get('supervisorUid', '') == request.auth.uid
|| isSelfId(d.get('delegateUid', ''))
|| isSelfId(resource.id);
}
function requestOrganizationUIDsOk() {
return !request.resource.data.keys().hasAll(['organizationUIDs'])
|| (request.resource.data.organizationUIDs is list
&& request.resource.data.organizationUIDs.size() >= 1
&& request.resource.data.organizationUIDs.size() <= 100
&& request.resource.data.organizationUIDs.hasAll([
request.resource.data.get('organizationUID', '')
]));
}
function requestPrimaryOrgExists() {
let d = request.resource.data;
let org = d.get('organizationUID', '');
return !d.keys().hasAll(['organizationUIDs'])
|| org == ''
|| exists(/databases/$(database)/documents/organizations/$(org));
}
function createDelegateRequestOk() {
let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
let r = u.get('role', '');
let org = u.get('organizationUID', '');
let co = u.get('companyUID', '');
let d = request.resource.data;
let incomingOrg = d.get('organizationUID', '') != ''
? d.get('organizationUID', '') : d.get('organizationId', '');
let incomingCo = d.get('companyUID', '') != ''
? d.get('companyUID', '') : d.get('companyId', '');
let isSa = r in superAdminRoleList();
let isOa = r in orgAdminCoreRoles()
&& d.get('supervisorUid', '') == request.auth.uid
&& org != '' && co != ''
&& incomingOrg == org
&& incomingCo == co;
let isCoStaff = r in companyAdminHrRoles()
&& d.get('supervisorUid', '') == request.auth.uid
&& co != ''
&& incomingCo == co;
return signedIn() && (isSa || isOa || isCoStaff)
