# Export in your shell or pass via maestro test -e (never commit secrets).
# Coordinator store: internal/tashil-dev-test-accounts.txt
TASHIL_MAESTRO_DEV_PHONE=01500000002
TASHIL_MAESTRO_DEV_SECRET=
# Delegates bind to the first device (docs/DEV_ENVIRONMENT.md, TAS-228).
# On an emulator or simulator use a seed delegate, which
# `hr-web-fake-accounts.js --reset-device-bindings --apply` can free:
# beta-1 (Promoter) 01000000018 / 00000000000201.
# 01500000003 / 29901015740919 is kept for the real M31 device.
TASHIL_MAESTRO_DEV_DELEGATE_PHONE=01000000018
# Fake national ID for the delegate above — public in docs/DEV_ENVIRONMENT.md
TASHIL_MAESTRO_DEV_DELEGATE_NATIONAL_ID=00000000000201
