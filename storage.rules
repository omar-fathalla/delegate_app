rules_version = '2';

// Craft rules based on data in your Firestore database
// allow write: if firestore.get(
//    /databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin;
service firebase.storage {
  match /b/{bucket}/o {

    // ==================== FEEDBACK SCREENSHOTS ====================
    // Screenshots attached to user feedbacks
    match /feedback_screenshots/{fileName} {
      // Read: Anyone can read (public access for viewing in app)
      allow read: if true;
      
      // Write: Only authenticated users can upload
      // Max size: 5MB
      // Only image files allowed
      allow write: if request.auth != null &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // ==================== DEFAULT DENY ====================
    // Any path not explicitly matched above will be denied
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
