rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ==================== HELPER FUNCTIONS ====================
    function isAuthenticated() {
      return request.auth != null;
    }

    // ==================== FEEDBACK SCREENSHOTS ====================
    // Screenshots attached to user feedbacks (delegates, supervisors, admins, marketing)
    match /feedback_screenshots/{fileName} {
      allow read, write: if isAuthenticated();
    }

    // ==================== PHOTO PERMISSION IMAGES ====================
    match /organizations/{orgId}/companies/{compId}/permissions/{permissionId}/{photoId} {
      allow read, write: if isAuthenticated();
    }

    // ==================== TASK IMAGES ====================
    // Images a supervisor attaches to a task. Only the uploader writes or
    // deletes their own files (<5 MB, image/*); any signed-in member of the
    // organization (staff users doc or delegate token) can read.
    // NOTE: Storage ORs overlapping matches, so this only restricts access
    // once the /organizations/{orgId}/{allPaths=**} and /{allPaths=**}
    // catch-alls below are narrowed. Until then they still allow any
    // authenticated user.
    match /organizations/{orgId}/task_images/{uploaderUid}/{fileName} {
      allow read: if isAuthenticated() && (
        request.auth.token.get('orgId', '') == orgId
        || orgId in request.auth.token.get('orgIds', [])
        || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('organizationUID', '') == orgId
      );
      allow create, update: if isAuthenticated()
        && request.auth.uid == uploaderUid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAuthenticated() && request.auth.uid == uploaderUid;
    }

    // ==================== ORGANIZATION FILES ====================
    match /organizations/{orgId}/{allPaths=**} {
      allow read, write: if isAuthenticated();
    }

    // ==================== COMPANY FILES ====================
    match /companies/{compId}/{allPaths=**} {
      allow read, write: if isAuthenticated();
    }

    match /companies/{fileName} {
      allow read, write: if isAuthenticated();
    }

    // ==================== DELEGATE FILES ====================
    match /delegates/{delegateId}/{allPaths=**} {
      allow read, write: if isAuthenticated();
    }

    // ==================== PENALTIES ATTACHMENTS ====================
    match /penalties/{allPaths=**} {
      allow read, write: if isAuthenticated();
    }

    // ==================== LEAVE ATTACHMENTS ====================
    match /leave_attachments/{allPaths=**} {
      allow read, write: if isAuthenticated();
    }

    // ==================== DELEGATE REGISTRATION & SUBSCRIPTION DOCUMENTS ====================
    // P-1: only the delegate, their company staff, and super-admin / tech.
    // Registration uploads to delegate_documents/{requestId} *before* the
    // request doc exists, so company staff may also access a folder that
    // has no users/{id} or delegate_requests/{id} doc yet. The catch-all
    // below must not OR this path back open.
    function storageUser() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function storageRole() {
      return request.auth != null && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        ? storageUser().get('role', '')
        : '';
    }
    function storageIsGlobal() {
      return storageRole() in [
        'super-admin', 'super_admin', 'superadmin', 'superAdmin', 'Super-Admin', 'SUPER_ADMIN',
        'technical_support', 'technical-support', 'technicalSupport', 'technicalsupport',
        'tech_support', 'techsupport'
      ];
    }
    function storageCallerCompany() {
      return request.auth != null && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        ? storageUser().get('companyUID', '')
        : '';
    }
    function storageIsCompanyStaff() {
      return storageCallerCompany() != '' && storageRole() in [
        'company-admin', 'company_admin', 'companyadmin', 'admin',
        'supervisor', 'company_supervisor',
        'hr', 'company-hr', 'company_hr', 'human_resources'
      ];
    }
    // Cloud Storage allows at most 2 unique Firestore document accesses
    // per request. A third unique get/exists is denied (the emulator does
    // not enforce this). We therefore touch only:
    //   1) users/{caller}   (role + company, via storageUser)
    //   2) delegate_requests/{delegateUid}  (folder company, if any)
    // Never look up users/{delegateUid} here. A missing request doc is
    // treated as an unresolved registration folder so company staff can
    // upload before the request is created.
    function storageFolderCompany(delegateUid) {
      return firestore.exists(/databases/(default)/documents/delegate_requests/$(delegateUid))
        ? firestore.get(/databases/(default)/documents/delegate_requests/$(delegateUid)).data.get('companyUID', '')
        : '';
    }
    function canAccessDelegateDocuments(delegateUid) {
      return isAuthenticated() && (
        request.auth.uid == delegateUid
        || storageIsGlobal()
        || (storageIsCompanyStaff() && (
          storageFolderCompany(delegateUid) == storageCallerCompany()
          || storageFolderCompany(delegateUid) == ''
        ))
      );
    }

    match /delegate_documents/{delegateUid}/{allPaths=**} {
      allow read, write: if canAccessDelegateDocuments(delegateUid);
    }

    match /delegate_subscription_receipts/{allPaths=**} {
      allow read, write: if isAuthenticated();
    }

    // ==================== PUBLIC FILES ====================
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ==================== STAGING PATH ====================
    match /staging/{allPaths=**} {
      allow read, write: if isAuthenticated();
    }

    // ==================== GUIDE VIDEOS PATH ====================
    match /guide-videos/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ==================== FALLBACK FOR ALL OTHER AUTHENTICATED PATHS ====================
    // Do not match delegate_documents: Storage ORs overlapping matches, so a
    // catch-all here would undo the tighter rule above.
    match /{firstSegment}/{rest=**} {
      allow read, write: if isAuthenticated() && firstSegment != 'delegate_documents';
    }
    match /{singleFile} {
      allow read, write: if isAuthenticated();
    }
  }
}
