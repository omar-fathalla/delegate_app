rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ==================== HELPER FUNCTIONS ====================
    function isAuthenticated() {
      return request.auth != null;
    }
    // Anonymous tokens count as authenticated. Use this to close that hole.
    function isNonAnonymous() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isStorageGlobalRole(role) {
      return role in [
        'super-admin', 'super_admin', 'superadmin', 'superAdmin',
        'Super-Admin', 'SUPER_ADMIN',
        'technical_support', 'technical-support', 'technicalSupport',
        'technicalsupport', 'tech_support', 'techsupport'
      ];
    }
    function isStorageCompanyStaffRole(role) {
      return role in [
        'company-admin', 'company_admin', 'companyadmin', 'admin',
        'supervisor', 'company_supervisor',
        'hr', 'company-hr', 'company_hr', 'human_resources',
        'organization-admin', 'organization_admin', 'organizationadmin',
        'organizationAdmin'
      ];
    }
    // Other non-delegate staff (marketing, accountant, …) may use
    // tenant-scoped company/org paths of their own company.
    function isStorageNamedStaffRole(role) {
      return isStorageCompanyStaffRole(role)
        || isStorageGlobalRole(role)
        || role in [
          'marketing',
          'marketingPromotion', 'marketing_promotion', 'marketing-promotion',
          'marketingpromotion',
          'branches_marketing_manager', 'branches-marketing-manager',
          'branches_marketing', 'branchesMarketingManager',
          'accountant', 'accounting', 'account_admin', 'account-admin'
        ];
    }
    function isStorageStaff() {
      return isNonAnonymous()
        && isStorageNamedStaffRole(
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', '')
        );
    }
    function storageStaffOrGlobalAccess(folderId) {
      let u = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      let role = u.get('role', '');
      let co = u.get('companyUID', '');
      let intentPath = /databases/(default)/documents/storage_upload_intents/$(folderId);
      // exists+get of the same doc counts as one of the two allowed gets.
      return isStorageGlobalRole(role)
        || (
          isStorageCompanyStaffRole(role)
          && co != ''
          && firestore.exists(intentPath)
          && firestore.get(intentPath).data.get('companyUID', '') == co
        );
    }
    function canAccessDelegateDocuments(folderId) {
      return isNonAnonymous() && (
        request.auth.uid == folderId
        || storageStaffOrGlobalAccess(folderId)
      );
    }

    function canAccessCompanyFiles(compId) {
      let u = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      let role = u.get('role', '');
      let co = u.get('companyUID', '');
      return isNonAnonymous() && (
        isStorageGlobalRole(role)
        || (isStorageNamedStaffRole(role) && co != '' && co == compId)
      );
    }

    // Delegate tokens always have role=delegate and companyId (singular).
    // companyIds is present only when the delegate is in more than one company.
    function isDelegateToken() {
      return isNonAnonymous()
        && request.auth.token.get('role', '') == 'delegate';
    }
    function delegateTokenOwnsCompany(compId) {
      return isDelegateToken()
        && compId != ''
        && (
          request.auth.token.get('companyId', '') == compId
          || compId in request.auth.token.get('companyIds', [])
        );
    }
    // Web ID-docs: registration-style company staff (admin / supervisor /
    // HR / org-admin) and global roles. Accountant and marketing stay out
    // so this path matches delegate_documents more closely.
    function canAccessWebIdDocs(compId) {
      let u = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      let role = u.get('role', '');
      let co = u.get('companyUID', '');
      return isNonAnonymous() && (
        isStorageGlobalRole(role)
        || (isStorageCompanyStaffRole(role) && co != '' && co == compId)
      );
    }



    // M3 residual: when the delegate token carries orgId+companyId and
    // the delegate doc exists, held accounts cannot write Storage. Skip
    // the get when claims are missing so older test tokens still work.
    // Reads stay allowed so the app can listen and sign out.
    function storageDelegatePath(orgId, co, uid) {
      return /databases/(default)/documents/organizations/$(orgId)/companies/$(co)/delegates/$(uid);
    }
    function storageDelegateAccountWritable(orgId, co, uid) {
      let d = firestore.get(storageDelegatePath(orgId, co, uid)).data;
      let st = d.get('status', 'active');
      let held = st == 'suspended' || st == 'inactive' || st == 'disabled' || st == 'rejected';
      let holdsEmpty = d.get('holds', {}).keys().size() == 0;
      return !held && holdsEmpty;
    }
    function callerDelegateMayWriteStorage() {
      let orgId = request.auth.token.get('orgId', '');
      let co = request.auth.token.get('companyId', '');
      let uid = request.auth.uid;
      return !isDelegateToken()
        || orgId == ''
        || co == ''
        || uid == ''
        || !firestore.exists(storageDelegatePath(orgId, co, uid))
        || storageDelegateAccountWritable(orgId, co, uid);
    }

    // ==================== FEEDBACK SCREENSHOTS ====================
    // Flat path kept so existing objects remain addressable. New
    // delegate creates must be named feedback_{uid}_<token> where
    // <token> has no extra underscore (typically a millisecond
    // timestamp) so a shorter uid cannot claim feedback_{uid}_2_*.
    // If userId metadata is present it must equal the caller, on
    // create and on read/update/delete. Metadata is optional on
    // create when the filename already names the caller; missing
    // metadata must not fail the rule (treat it as empty).
    // Legacy flat-name creates by delegates are denied: older app
    // builds that uploaded a name like dlgA-fb.png can no longer
    // create. Existing legacy objects that are not
    // feedback_{otherUid}_* stay readable/updatable/deletable by
    // the delegate when userId metadata equals the caller. Staff
    // of any company still have full access (residual: no company
    // segment). New clients write feedback_{uid}_{ts}.jpg.
    function feedbackNameOwnedByCaller(fileName) {
      return request.auth.uid != ''
        && fileName.matches('feedback_' + request.auth.uid + '_[^_]+(\\.[A-Za-z0-9]+)?$');
    }
    function feedbackNameOwnedByOther(fileName) {
      return fileName.matches('feedback_.*_.*')
        && !feedbackNameOwnedByCaller(fileName);
    }
    function storageMetaUserId(meta) {
      return meta == null ? '' : meta.get('userId', '');
    }
    function feedbackMetaOk(userId) {
      return userId == '' || userId == request.auth.uid;
    }
    function feedbackDelegateMayAccess(fileName) {
      return isDelegateToken()
        && request.auth.uid != ''
        && feedbackMetaOk(storageMetaUserId(resource.metadata))
        && (
          feedbackNameOwnedByCaller(fileName)
          || (
            !feedbackNameOwnedByOther(fileName)
            && storageMetaUserId(resource.metadata) == request.auth.uid
          )
        );
    }
    match /feedback_screenshots/{fileName} {
      // Overwrites must be evaluated against the existing object's
      // owner even if a client upload is classified as create.
      allow read: if isStorageStaff()
        || feedbackDelegateMayAccess(fileName);
      allow create, update: if isStorageStaff()
        || (
          isDelegateToken()
          && callerDelegateMayWriteStorage()
          && feedbackMetaOk(storageMetaUserId(request.resource.metadata))
          && (
            (resource == null && feedbackNameOwnedByCaller(fileName))
            || (resource != null && feedbackDelegateMayAccess(fileName))
          )
        );
      allow delete: if isStorageStaff()
        || (feedbackDelegateMayAccess(fileName) && callerDelegateMayWriteStorage());
    }

    // ==================== PHOTO PERMISSION IMAGES ====================
    // Delegates of the company may create and read. Update/delete is
    // own-uid only: the name must be photo_{uid}_<token> where <token>
    // has no extra underscore (app: photo_{uid}_{ts}.jpg), or metadata
    // userId/delegateUid equals the caller. A prefix match is not
    // enough: photo_{uid}_2_{ts} belongs to uid_2, not uid.
    // Legacy photo_{timestamp}.jpg has no owner in the name; delegates
    // cannot overwrite or delete those (staff can). Old clients that
    // still upload photo_{timestamp}.jpg can create new objects.
    function permissionPhotoNameOwnedByCaller(photoId) {
      return request.auth.uid != ''
        && photoId.matches('photo_' + request.auth.uid + '_[^_]+(\\.[A-Za-z0-9]+)?$');
    }
    function permissionPhotoNameOwnedByOther(photoId) {
      return photoId.matches('photo_.*_.*')
        && !permissionPhotoNameOwnedByCaller(photoId);
    }
    function delegateOwnsPermissionPhoto(photoId) {
      return isDelegateToken()
        && request.auth.uid != ''
        && (
          permissionPhotoNameOwnedByCaller(photoId)
          || storageMetaUserId(resource.metadata) == request.auth.uid
          || (resource.metadata != null && resource.metadata.get('delegateUid', '') == request.auth.uid)
        );
    }
    match /organizations/{orgId}/companies/{compId}/permissions/{permissionId}/{photoId} {
      allow read: if canAccessCompanyFiles(compId)
        || delegateTokenOwnsCompany(compId);
      // Filename photo_{uid}_* is treated as owned by that uid so a
      // create-classified overwrite cannot steal a colleague's object.
      allow create, update: if canAccessCompanyFiles(compId)
        || (delegateTokenOwnsCompany(compId)
          && callerDelegateMayWriteStorage()
          && !permissionPhotoNameOwnedByOther(photoId)
          && (resource == null || delegateOwnsPermissionPhoto(photoId)));
      allow delete: if canAccessCompanyFiles(compId)
        || (delegateTokenOwnsCompany(compId)
          && callerDelegateMayWriteStorage()
          && delegateOwnsPermissionPhoto(photoId));
    }

    // ==================== TASK IMAGES ====================
    // Images a supervisor attaches to a task. Only the uploader writes or
    // deletes their own files (<5 MB, image/*); any signed-in member of the
    // organization (staff users doc or delegate token) can read.
    // NOTE: Storage ORs overlapping matches, so this only restricts access
    // once the /organizations/{orgId}/{allPaths=**} and /{allPaths=**}
    // catch-alls below are narrowed. Until then they still allow any
    // non-anonymous signed-in user.
    match /organizations/{orgId}/task_images/{uploaderUid}/{fileName} {
      allow read: if isNonAnonymous() && (
        request.auth.token.get('orgId', '') == orgId
        || orgId in request.auth.token.get('orgIds', [])
        || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('organizationUID', '') == orgId
      );
      allow create, update: if isNonAnonymous()
        && request.auth.uid == uploaderUid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isNonAnonymous() && request.auth.uid == uploaderUid;
    }

    // Web stores ID documents at
    // organizations/{org}/companies/{co}/delegates/{uid}/...
    // Tenant-scope by the company segment so those paths stay usable
    // without an intent (the web repo is not changed in this PR).
    match /organizations/{orgId}/companies/{compId}/delegates/{delegateUid}/{allPaths=**} {
      allow read, write: if canAccessWebIdDocs(compId)
        || (isNonAnonymous() && request.auth.uid == delegateUid);
    }
    // Storage ORs overlapping matches, so this residual must not also
    // match .../delegates/{uid}/** or canAccessWebIdDocs is undone and
    // accountant/marketing would regain ID-doc access.
    match /organizations/{orgId}/companies/{compId}/{segment}/{rest=**} {
      allow read, write: if segment != 'delegates' && canAccessCompanyFiles(compId);
    }

    // ==================== ORGANIZATION FILES ====================
    // Storage ORs overlapping matches, so this must itself be tenant
    // scoped or it would reopen the companies/{compId} rule above.
    function canAccessOrganization(orgId) {
      let u = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      let role = u.get('role', '');
      let co = u.get('companyUID', '');
      let org = u.get('organizationUID', '');
      let orgPath = /databases/(default)/documents/organizations/$(orgId);
      return isNonAnonymous() && isStorageNamedStaffRole(role) && (
        isStorageGlobalRole(role)
        || (org != '' && org == orgId)
        || (
          co != ''
          && firestore.exists(orgPath)
          && firestore.get(orgPath).data.get('companyUID', '') == co
        )
      );
    }
    // Must not also match .../companies/{compId}/** or the company
    // tenant rule above is undone by this OR.
    match /organizations/{orgId}/{segment}/{rest=**} {
      allow read, write: if segment != 'companies' && canAccessOrganization(orgId);
    }

    // ==================== COMPANY FILES ====================
    // Tenant-scoped when the path is the company id.
    match /companies/{compId}/{allPaths=**} {
      allow read, write: if canAccessCompanyFiles(compId);
    }

    match /companies/{fileName} {
      allow read, write: if isStorageStaff();
    }

    // ==================== DELEGATE FILES ====================
    match /delegates/{delegateId}/{allPaths=**} {
      allow read, write: if canAccessDelegateDocuments(delegateId);
    }

    // ==================== PENALTIES ATTACHMENTS ====================
    // New uploads use penalties/{companyUID}/evidence/{penaltyId}/...
    // and are tenant-scoped. The legacy path penalties/evidence/...
    // stays readable by any named staff so existing objects and old
    // clients that only GET remain usable; new writes on the legacy
    // path are denied.
    match /penalties/{compId}/evidence/{penaltyId}/{allPaths=**} {
      allow read, write: if canAccessCompanyFiles(compId);
    }
    match /penalties/evidence/{allPaths=**} {
      allow read: if isStorageStaff();
      allow write: if false;
    }

    // ==================== LEAVE ATTACHMENTS ====================
    // App path: leave_attachments/{companyUID}/{uid}/...
    // Staff: same-company HR / supervisor / org-admin (or global),
    // same set as web ID-docs. Accountant and marketing are out;
    // their screens do not use this path. The folder owner may write
    // their own uid segment when the token company matches.
    match /leave_attachments/{compId}/{uid}/{allPaths=**} {
      allow read: if canAccessWebIdDocs(compId)
        || (delegateTokenOwnsCompany(compId) && request.auth.uid == uid);
      allow write: if canAccessWebIdDocs(compId)
        || (delegateTokenOwnsCompany(compId)
          && request.auth.uid == uid
          && callerDelegateMayWriteStorage());
    }

    // ==================== DELEGATE REGISTRATION & SUBSCRIPTION DOCUMENTS ====================
    // P-1: the folder owner (uid == folder id), company staff / HR / org-admin
    // of the SAME company, and super-admin / technical support.
    // Anonymous tokens are denied even though request.auth != null.
    //
    // Staff access requires a prior storage_upload_intents/{folderId} doc
    // whose companyUID matches the caller. Intents are created only by
    // the ensureStorageUploadIntent callable, which verifies the folder's
    // owning company (request or delegate). Backfill every delegate uid
    // so same-company staff keep access to web/legacy folders. There is
    // no empty-company fallback. At most two firestore.get calls:
    // users/{caller} and storage_upload_intents/{folderId}. The
    // folder-owner check short-circuits with zero gets.
    //
    // Cross-service IAM: the Cloud Storage for Firebase service agent
    // (service-<PROJECT_NUMBER>@gcp-sa-firebasestorage.iam.gserviceaccount.com)
    // must have roles/firebaserules.firestoreServiceAgent on the project,
    // or these gets deny and staff uploads fail. Granted on tashil-dev;
    // prod is a separate, owner-approved change.
    match /delegate_documents/{delegateUid}/{allPaths=**} {
      allow read, write: if canAccessDelegateDocuments(delegateUid);
    }

    // Same tenant check as documents when an intent exists for the request id
    // (registration writes the intent first). Anonymous is denied.
    match /delegate_subscription_receipts/{requestId}/{allPaths=**} {
      allow read, write: if canAccessDelegateDocuments(requestId);
    }

    // ==================== PUBLIC FILES ====================
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isStorageStaff();
    }

    // ==================== STAGING PATH ====================
    // Web also writes staging/requests/{id}/... Keep the path, but
    // tenant-scope it like delegate_documents (intent or folder owner).
    // Other staging prefixes are staff-only.
    match /staging/requests/{requestId}/{allPaths=**} {
      allow read, write: if canAccessDelegateDocuments(requestId);
    }
    // Storage ORs overlapping matches, so this residual must not
    // also match staging/requests/{id} or the intent check above is undone.
    match /staging/{segment}/{rest=**} {
      allow read, write: if segment != 'requests' && isStorageStaff();
    }

    // ==================== GUIDE VIDEOS PATH ====================
    match /guide-videos/{fileName} {
      allow read, write: if isStorageStaff();
    }

    // ==================== FALLBACK FOR ALL OTHER AUTHENTICATED PATHS ====================
    // Do not match delegate_documents: Storage ORs overlapping matches, so a
    // catch-all here would undo the tighter rule above.
    // Storage ORs overlapping matches, so tenant-scoped prefixes must be
    // excluded from this catch-all or the tighter rules above are undone.
    match /{firstSegment}/{rest=**} {
      allow read, write: if isStorageStaff()
        && firstSegment != 'delegate_documents'
        && firstSegment != 'delegate_subscription_receipts'
        && firstSegment != 'companies'
        && firstSegment != 'organizations'
        && firstSegment != 'delegates'
        && firstSegment != 'staging'
        && firstSegment != 'penalties'
        && firstSegment != 'leave_attachments'
        && firstSegment != 'feedback_screenshots'
        && firstSegment != 'public';
    }
    match /{singleFile} {
      allow read, write: if isStorageStaff();
    }
  }
}
