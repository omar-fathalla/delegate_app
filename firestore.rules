rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global rule: allow all authenticated users (Web Dashboard)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Delegates collectionGroup: allow unauthenticated read for mobile app login
    match /{path=**}/delegates/{delegateId} {
      allow read: if true;
      allow write: if false;
    }

    // --- Delegate App Rules ---

    // 1. Attendance Logs (New System) - Authenticated, Append-Only
    match /attendance_logs/{document=**} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }

    // 2. Testing Logs (Dev Environment)
    match /attendance_logs_testing/{document=**} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }

    // 3. Delegate Profile (Read-Only)
    match /users/{userId} {
      allow read: if request.auth != null;
    }

    // 4. Organization/Company Data (Read-Only)
    match /organizations/{orgId}/companies/{compId}/delegates/{userId} {
      allow read: if request.auth != null;
    }
    
    // --- End Delegate App Rules ---
  }
}
