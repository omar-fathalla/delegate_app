rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global rule: allow all authenticated users (Web Dashboard)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Delegates collectionGroup: allow unauthenticated read for mobile app login
    match /{path=**}/delegates/{delegateId} {
      allow read: if true;
      allow write: if false;
    }

    // Attendance: allow unauthenticated access for mobile app
    match /attendance/{attendanceId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
  }
}
