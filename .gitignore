.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
ios/build/
/coverage/
*.xcbuilddata/
chrome_log*.txt

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android SDK path and local keys (never commit)
android/local.properties

# Node dependencies
node_modules/
**/node_modules/
package-lock.json
!functions/package-lock.json

# Local env files
.env*
# Checked-in deploy defaults (mode only, no secrets). firebase deploy
# loads functions/.env then functions/.env.<project>.
!functions/.env
!functions/.env.tashil-dev

# Keystore and credentials files
android/key.properties
key.properties
android/app/upload-keystore.jks
*.jks
*.p12
*.p8
*.mobileprovision

# iOS Certificates (sensitive - never commit)
*.p12
Certificates.p12
Certificates_modern.p12
# Binaries & packages
*.apk
*.aab

# Firebase cache
.firebase/
.agent_real_test/

# Local real-test screenshots (may contain PII)
docs/real_test_shots/

# Backfill dry-run reports (local)
functions/backfill-report*.json

# Local perf probe artifacts (screenshots may contain PII)
real_test/

# tashil-dev iOS plist (never commit; see ios/config/README.md)
ios/config/dev/GoogleService-Info.plist

# Never commit 1st-gen Functions runtime config (may hold secrets).
functions/.runtimeconfig.json
.runtimeconfig.json
