// Patrol `xcodebuild build-for-testing` uses generic/platform=iOS Simulator (arm64+x86_64).
// Pin a single simulator slice so Flutter debug frameworks and plugin Pods link on Apple Silicon.
// Device (iphoneos) builds are unchanged — keys are simulator-scoped only.
SDKROOT = iphoneos
SDKROOT[sdk=iphonesimulator*] = iphonesimulator
ARCHS[sdk=iphonesimulator*] = arm64
EXCLUDED_ARCHS[sdk=iphonesimulator*] = $(inherited) arm64e i386 x86_64
ONLY_ACTIVE_ARCH[sdk=iphonesimulator*] = YES
