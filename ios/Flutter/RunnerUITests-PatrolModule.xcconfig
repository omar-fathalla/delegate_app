// Patrol @import — module map from plugin symlink (works before CocoaPods generates
// Target Support Files/patrol/patrol.modulemap, including Flutter SPM-thin pod installs).
PATROL_MODULEMAP=${PODS_ROOT}/../.symlinks/plugins/patrol/darwin/patrol/Sources/patrol/include/module.modulemap
OTHER_CFLAGS=$(inherited) -fmodule-map-file="$(PATROL_MODULEMAP)"
HEADER_SEARCH_PATHS=$(inherited) "${PODS_ROOT}/../.symlinks/plugins/patrol/darwin/patrol/Sources/patrol/include" "${PODS_CONFIGURATION_BUILD_DIR}/patrol/patrol.framework/Headers"
SWIFT_INCLUDE_PATHS=$(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/patrol"
