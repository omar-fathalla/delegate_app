# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# Native Firebase iOS SDK version for FlutterFire CocoaPods resolution (firebase_core 4.15.2 → 12.19.3).
$FirebaseSDKVersion = '12.19.3'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
  'Debug-dev' => :debug,
  'Profile-dev' => :release,
  'Release-dev' => :release,
  'Debug-prod' => :debug,
  'Profile-prod' => :release,
  'Release-prod' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

def tashil_pod_env_for_scripts
  {
    'SRCROOT' => File.expand_path(__dir__),
    'CONFIGURATION' => ENV['CONFIGURATION'],
    'APP_ENV' => ENV['APP_ENV'],
    'DART_DEFINES' => ENV['DART_DEFINES'],
    'PRODUCT_BUNDLE_IDENTIFIER' => ENV['PRODUCT_BUNDLE_IDENTIFIER'],
  }
end

def tashil_dev_flutter_build?
  script = File.expand_path('scripts/tashil_is_dev_build.sh', __dir__)
  system(tashil_pod_env_for_scripts, '/bin/sh', script)
end

def tashil_strip_dev_crashlytics_if_needed!
  wrapper = File.expand_path('scripts/tashil_strip_dev_crashlytics_if_dev.sh', __dir__)
  return unless File.exist?(wrapper)
  return unless tashil_dev_flutter_build?

  success = system(tashil_pod_env_for_scripts, '/bin/sh', wrapper)
  raise '[Tashil] tashil_strip_dev_crashlytics_if_dev.sh failed during pod install' unless success
end

# Before CocoaPods resolves dependencies (including SPM integration from Flutter ephemeral).
pre_install do |_installer|
  tashil_strip_dev_crashlytics_if_needed!
end

# When pod install runs for dev, strip may exist before target hooks run.
tashil_strip_dev_crashlytics_if_needed!

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerUITests' do
    inherit! :search_paths
    pod 'patrol', :path => '.symlinks/plugins/patrol/darwin'
  end
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
      config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
      config.build_settings['PROVISIONING_PROFILE_SPECIFIER'] = ''
    end
  end

  tashil_strip_dev_crashlytics_if_needed!

  pod_strip = File.expand_path('scripts/tashil_strip_crashlytics_from_dev_pod_support.sh', __dir__)
  if File.exist?(pod_strip)
    success = system('/bin/sh', pod_strip, File.expand_path(__dir__))
    raise '[Tashil] tashil_strip_crashlytics_from_dev_pod_support.sh failed during pod install' unless success
  end

  require_relative 'patrol_runner_ui_tests_post_install'
  PatrolRunnerUiTestsPostInstall.apply!(installer)
end
