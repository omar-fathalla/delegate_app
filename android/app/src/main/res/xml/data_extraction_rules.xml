<?xml version="1.0" encoding="utf-8"?>
<!--
  TAS-288: never back up or transfer app data. Restoring the cached delegate
  on a new phone without its Firebase Auth session left delegates signed in
  but unable to write (permission-denied, TAS-286).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
